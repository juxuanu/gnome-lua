<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome-lua.example.prefs" path="/org/gnome-lua/example/prefs/">
    <key name="show-banner" type="b">
      <default>true</default>
      <summary>Log a banner line with the greeting when the extension starts</summary>
    </key>
    <key name="greeting" type="s">
      <default>"Hello"</default>
      <summary>The text of the banner</summary>
    </key>
    <key name="format" type="s">
      <choices>
        <choice value="short"/>
        <choice value="long"/>
      </choices>
      <default>"short"</default>
      <summary>How much each tick says</summary>
    </key>
    <key name="columns" type="i">
      <default>2</default>
      <summary>An integer chosen from a list</summary>
    </key>
    <key name="interval" type="i">
      <range min="1" max="60"/>
      <default>5</default>
      <summary>Seconds between two ticks</summary>
    </key>
    <key name="opacity" type="d">
      <range min="0.0" max="1.0"/>
      <default>0.8</default>
      <summary>A fraction</summary>
    </key>
    <key name="accent" type="s">
      <default>"#3584e4"</default>
      <summary>A colour without transparency</summary>
    </key>
    <key name="highlight" type="s">
      <default>"rgba(53, 132, 228, 0.5)"</default>
      <summary>A colour with transparency</summary>
    </key>
    <key name="toggle-shortcut" type="as">
      <default>["&lt;Super&gt;e"]</default>
      <summary>Keyboard shortcuts</summary>
    </key>
  </schema>
</schemalist>
